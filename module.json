{
  "apiVersion": 2,
  "id": "container",
  "name": "Container",
  "version": "3.1.1",
  "description": "Docker and Incus side by side: containers with CPU, memory, network and block I/O, inspect with logs and an exec shell, images, volumes and networks - plus tags, bulk create and bulk actions with a check step before anything runs, and installing either runtime on a machine that has neither.",
  "author": "Bored Manager",
  "minAppVersion": "0.2.0",
  "defaultEnabled": false,
  "entries": {
    "main": "main/index.ts"
  },
  "pages": [
    { "id": "dashboard", "label": "Dashboard", "icon": "Gauge", "order": 60 },
    { "id": "docker", "label": "Docker", "icon": "Container", "order": 61 },
    { "id": "images", "label": "Images & storage", "icon": "Boxes", "order": 62 },
    { "id": "logs", "label": "Logs", "icon": "FileText", "order": 63 },
    { "id": "incus", "label": "Incus", "icon": "Server", "order": 64 },
    { "id": "fleet", "label": "Fleet operations", "icon": "Layers", "order": 65 },
    { "id": "settings", "label": "Module settings", "icon": "Settings2", "order": 66 }
  ],
  "widgets": [
    { "id": "summary", "label": "Containers", "defaultEnabled": true, "order": 4 },
    { "id": "resources", "label": "Container resources", "order": 70 }
  ],
  "streams": [
    { "event": "snapshot", "kind": "latest" },
    { "event": "incus", "kind": "latest" },
    { "event": "series", "kind": "series" },
    { "event": "storage", "kind": "latest" },
    { "event": "jobs", "kind": "latest" },
    { "event": "install", "kind": "latest" }
  ],
  "methods": [
    "images",
    "volumes",
    "networks",
    "inspect",
    "containerAction",
    "removeImage",
    "pruneImages",
    "removeVolume",
    "pruneVolumes",
    "removeNetwork",
    "pruneNetworks",
    "logsStart",
    "logsStop",
    "incusAction",
    "incusInspect",
    "incusImages",
    "incusProfiles",
    "incusNetworks",
    "incusPools",
    "tags",
    "tagMembers",
    "tagCheck",
    "tagApply",
    "tagDelete",
    "tagsPrune",
    "bulkTag",
    "bulkContainerAction",
    "bulkIncusAction",
    "jobs",
    "jobCancel",
    "jobsClear",
    "selectOptions",
    "templates",
    "templateDelete",
    "createDockerCheck",
    "createDockerApply",
    "createIncusCheck",
    "createIncusApply",
    "bulkActionCheck",
    "bulkActionApply",
    "networkCreateCheck",
    "networkCreateApply",
    "rulesEffective",
    "rulesCheck",
    "rulesApply",
    "rulesReset",
    "installDockerCheck",
    "installDockerApply",
    "installIncusCheck",
    "installIncusApply",
    "installLogTail",
    "installCancel"
  ],
  "fastInterval": "container",
  "slowInterval": "container"
}
