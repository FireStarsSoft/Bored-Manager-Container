{
  "blocks": [
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "snapshot", "path": "available" }, "op": "eq", "value": false },
      "blocks": [
        {
          "type": "section",
          "title": "Docker is not available on this machine",
          "blocks": [
            {
              "type": "checkForm",
              "title": "Install Docker",
              "checkMethod": "installDockerCheck",
              "applyMethod": "installDockerApply",
              "applyLabel": "Install Docker",
              "kind": "danger",
              "fields": [
                {
                  "key": "mode",
                  "label": "How",
                  "input": "select",
                  "initial": "default",
                  "options": [
                    { "value": "default", "label": "The distro's own package (docker.io / moby-engine / docker)" },
                    { "value": "custom", "label": "A command I type myself" }
                  ],
                  "help": "The default installs from the distro's repositories and starts the service. No third-party repository is added."
                },
                {
                  "key": "command",
                  "label": "Custom command",
                  "input": "textarea",
                  "placeholder": "DEBIAN_FRONTEND=noninteractive apt-get update -qq && apt-get install -y docker.io && systemctl enable --now docker",
                  "help": "Only used with \"A command I type myself\". One line, run as root exactly as typed."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "incus", "path": "available" }, "op": "eq", "value": false },
      "blocks": [
        {
          "type": "section",
          "title": "Incus is not available on this machine",
          "blocks": [
            {
              "type": "checkForm",
              "title": "Install Incus",
              "checkMethod": "installIncusCheck",
              "applyMethod": "installIncusApply",
              "applyLabel": "Install Incus",
              "kind": "danger",
              "fields": [
                {
                  "key": "mode",
                  "label": "How",
                  "input": "select",
                  "initial": "default",
                  "options": [
                    { "value": "default", "label": "The distro's own package (incus)" },
                    { "value": "custom", "label": "A command I type myself" }
                  ],
                  "help": "Incus needs one more step afterwards: run `incus admin init` on the machine to choose storage and networking."
                },
                {
                  "key": "command",
                  "label": "Custom command",
                  "input": "textarea",
                  "placeholder": "apt-get update -qq && apt-get install -y incus",
                  "help": "Only used with \"A command I type myself\". One line, run as root exactly as typed."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "conditional",
      "when": { "source": { "kind": "stream", "event": "install", "path": "kind" }, "op": "exists" },
      "blocks": [
        {
          "type": "section",
          "title": "Install output",
          "blocks": [
            {
              "type": "keyValue",
              "source": { "kind": "stream", "event": "install" },
              "rows": [
                { "key": "kind", "label": "Installing" },
                { "key": "running", "label": "Running" },
                { "key": "ok", "label": "Finished successfully" }
              ]
            },
            { "type": "log", "event": "installlog", "startMethod": "installLogTail" },
            {
              "type": "actions",
              "actions": [
                {
                  "label": "Cancel install",
                  "method": "installCancel",
                  "confirm": "Stop the install command? The machine may be left with the package half installed.",
                  "kind": "danger"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Rules in force",
      "blocks": [
        {
          "type": "keyValue",
          "source": { "kind": "invoke", "method": "rulesEffective", "intervalKey": "container" },
          "rows": [
            { "key": "maxCreateCount", "label": "Largest create job" },
            { "key": "preferIncusThreshold", "label": "Suggest Incus at" },
            { "key": "maxParallel", "label": "Parallel items at once" },
            { "key": "bulkActionWarn", "label": "Warn on bulk action size" },
            { "key": "memHeadroomPct", "label": "Memory headroom %" },
            { "key": "minPasswordLen", "label": "Minimum password length" },
            { "key": "itemTimeoutSec", "label": "Per-item timeout (s)" },
            { "key": "enableArpAdvisory", "label": "Neighbour table advisories" }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Change the rules",
      "blocks": [
        {
          "type": "checkForm",
          "checkMethod": "rulesCheck",
          "applyMethod": "rulesApply",
          "applyLabel": "Save rules",
          "fields": [
            {
              "key": "maxCreateCount",
              "label": "Largest create job",
              "input": "number",
              "help": "1 to 500. Empty uses the default of 50."
            },
            {
              "key": "preferIncusThreshold",
              "label": "Suggest Incus at",
              "input": "number",
              "help": "1 to 500. Creating this many Docker containers at once earns a warning. Default 10."
            },
            {
              "key": "maxParallel",
              "label": "Parallel items at once",
              "input": "number",
              "help": "1 to 16. Default 4."
            },
            {
              "key": "bulkActionWarn",
              "label": "Warn on bulk action size",
              "input": "number",
              "help": "1 to 1000. Default 25."
            },
            {
              "key": "memHeadroomPct",
              "label": "Memory headroom %",
              "input": "number",
              "help": "50 to 100. Warn once a job would take more than this share of available memory. Default 90."
            },
            {
              "key": "minPasswordLen",
              "label": "Minimum password length",
              "input": "number",
              "help": "4 to 128. Default 8."
            },
            {
              "key": "itemTimeoutSec",
              "label": "Per-item timeout (s)",
              "input": "number",
              "help": "10 to 3600. Default 120."
            },
            {
              "key": "enableArpAdvisory",
              "label": "Warn when an L2 network would outgrow the neighbour table",
              "input": "checkbox",
              "initial": true
            }
          ]
        },
        {
          "type": "actions",
          "actions": [
            {
              "label": "Reset all overrides",
              "method": "rulesReset",
              "confirm": "Put every rule back to its default?",
              "kind": "danger"
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Templates",
      "blocks": [
        {
          "type": "table",
          "source": { "kind": "invoke", "method": "templates", "intervalKey": "container" },
          "rowKey": "id",
          "columns": [
            { "key": "name", "label": "Name" },
            { "key": "kind", "label": "For" },
            { "key": "fields", "label": "Fields", "format": "number", "align": "right" },
            { "key": "createdAt", "label": "Saved", "format": "duration", "align": "right" }
          ],
          "sortDefault": { "key": "name", "dir": "asc" },
          "emptyText": "No templates saved yet",
          "rowActions": [
            {
              "label": "Delete",
              "method": "templateDelete",
              "argsFromRow": ["id"],
              "confirm": "Delete this template?",
              "kind": "danger"
            }
          ]
        }
      ]
    }
  ]
}
